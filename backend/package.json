{
  "name": "vruttaant-backend",
  "version": "1.0.0",
  "description": "Backend API for Vruttaant multilingual card-based news app",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint src/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "loadtest:baseline": "node src/loadtest/runBaseline.js",
    "loadtest:baseline:strict": "LOADTEST_STRICT_SLO=true node src/loadtest/runBaseline.js",
    "job:reprocess-missing-metadata": "node src/jobs/reprocessMissingMetadata.js",
    "security:audit": "npm audit --audit-level=high",
    "infra:up": "docker compose -f ../docker-compose.yml up -d",
    "infra:down": "docker compose -f ../docker-compose.yml down",
    "infra:ps": "docker compose -f ../docker-compose.yml ps"
  },
  "keywords": [
    "news",
    "express",
    "multilingual",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "node-cron": "^4.2.1",
    "prom-client": "^15.1.3"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
