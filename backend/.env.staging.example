NODE_ENV=staging
PORT=5000
MONGODB_URI=mongodb://admin:admin123@127.0.0.1:27017/vruttaant_staging?authSource=admin
CORS_ALLOWED_ORIGINS=https://staging.vruttaant.app,https://staging-admin.vruttaant.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
JSON_PAYLOAD_LIMIT=10kb
JWT_ACCESS_SECRET=replace-with-staging-access-secret
JWT_REFRESH_SECRET=replace-with-staging-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_MS=604800000
PASSWORD_SALT_ROUNDS=12
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=staging
