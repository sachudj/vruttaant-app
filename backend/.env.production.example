NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
REDIS_URL=redis://127.0.0.1:6379
CORS_ALLOWED_ORIGINS=https://vruttaant.app,https://app.vruttaant.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
JSON_PAYLOAD_LIMIT=10kb
CACHE_TTL_NEWS_CARDS=300
CACHE_TTL_RECOMMENDED=120
CACHE_TTL_ANALYTICS=600
IMAGE_CDN_BASE_URL=https://cdn.vruttaant.app/fetch
IMAGE_CDN_URL_TEMPLATE=
IMAGE_CDN_DEFAULT_WIDTH=1200
IMAGE_CDN_DEFAULT_QUALITY=80
JWT_ACCESS_SECRET=replace-with-production-access-secret
JWT_REFRESH_SECRET=replace-with-production-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_MS=604800000
PASSWORD_SALT_ROUNDS=12
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
APP_VERSION=prod
