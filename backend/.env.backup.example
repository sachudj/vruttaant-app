# Backup automation defaults
# Copy these into your environment/secrets manager for staging/production.

# Optional override for backup and restore scripts
COMPOSE_FILE=../docker-compose.yml

# MongoDB backup target configuration
DB_NAME=vruttaant
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_AUTH_DB=admin

# Backup storage and retention
BACKUP_DIR=../backups/mongodb
BACKUP_RETENTION_COUNT=14

# Verification helper DB (used by scripts/verify-backup-restore.sh)
VERIFY_DB=vruttaant_backup_verify
VERIFY_BACKUP_DIR=../backups/mongodb/verify
