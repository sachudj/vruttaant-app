#!/usr/bin/env sh
# Pre-push hook — mirrors CI checks locally.
# To bypass in an emergency: git push --no-verify

set -e

ROOT="$(git rev-parse --show-toplevel)"

fail() {
  echo ""
  echo "╔══════════════════════════════════════════════════════╗"
  echo "║  ✖  PRE-PUSH FAILED: $1"
  echo "║     Push aborted. Fix the issue or use:"
  echo "║     git push --no-verify   (emergency bypass only)"
  echo "╚══════════════════════════════════════════════════════╝"
  exit 1
}

echo ""
echo "┌──────────────────────────────────────────────────────┐"
echo "│  Running CI checks before push…                      │"
echo "└──────────────────────────────────────────────────────┘"

# ── 1. Backend syntax parity ────────────────────────────────
echo ""
echo "▶ [1/7] Backend syntax checks"
(cd "$ROOT/backend" && npm run ci:syntax --silent) || fail "Backend syntax checks"

# ── 2. Backend lint ─────────────────────────────────────────
echo ""
echo "▶ [2/7] Backend lint"
(cd "$ROOT/backend" && npm run lint --silent) || fail "Backend lint"

# ── 3. Backend tests + coverage gates ───────────────────────
echo ""
echo "▶ [3/7] Backend tests (coverage gates)"
(cd "$ROOT/backend" && npm run test:coverage -- --runInBand) || fail "Backend coverage"

# ── 4. Backend security audit ───────────────────────────────
echo ""
echo "▶ [4/7] Backend security audit"
(cd "$ROOT/backend" && npm run security:audit) || fail "Backend security audit"

# ── 5. Backend boot health smoke ────────────────────────────
echo ""
echo "▶ [5/7] Backend boot health smoke"
(cd "$ROOT/backend" && npm run ci:health --silent) || fail "Backend health smoke"

# ── 6. Mobile JVM unit tests ────────────────────────────────
echo ""
echo "▶ [6/7] Mobile JVM unit tests"
(cd "$ROOT/mobile_app" && chmod +x gradlew && ./gradlew testDebugUnitTest) || fail "Mobile unit tests"

# ── 7. APK sync check (final gate) ─────────────────────────
if [ "${SKIP_APK_SYNC_CHECK:-0}" = "1" ]; then
  echo ""
  echo "▶ [7/7] Mobile latest APK sync check (skipped by SKIP_APK_SYNC_CHECK=1)"
else
  echo ""
  echo "▶ [7/7] Mobile latest APK sync check"
  (cd "$ROOT" && npm run mobile:apk-sync-check --silent) || fail "Mobile latest APK sync"
fi

echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║  ✔  All checks passed — pushing.                    ║"
echo "╚══════════════════════════════════════════════════════╝"
echo ""
